# Dicteren.ai web env example — placeholders only, no real secrets.
DATABASE_URL=postgres://USER:***@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgres://USER:***@HOST/DB?sslmode=require
NEXT_PUBLIC_APP_URL=https://www.dicteren.ai

# Instantly lifecycle webhook receiver (/api/instantly/webhook).
# Configure the same value as custom header x-instantly-secret in Instantly.
INSTANTLY_WEBHOOK_SECRET=replace-with-shared-secret-generated-outside-git

# Instantly API v2 key (scopes webhooks:all of all:all). Gebruikt door
# scripts/setup-instantly-webhook.ts en de instantly-reconcile cron.
INSTANTLY_API_KEY=replace-with-instantly-api-key
